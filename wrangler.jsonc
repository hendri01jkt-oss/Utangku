{
  // Satu Worker: aplikasi (dist/) + API (/api/*) + D1 + R2.
  "name": "utangku",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "utangku-db",
      "database_id": "f6da5c0a-1129-4f16-abae-80240d335e6f"
    }
  ],
  "r2_buckets": [{ "binding": "FOTO", "bucket_name": "utangku-foto" }],
  // 23:00 UTC = 06:00 WIB: menandai pengingat jatuh tempo.
  "triggers": { "crons": ["0 23 * * *"] },
  "observability": { "enabled": true }
}
