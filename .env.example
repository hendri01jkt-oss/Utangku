# Salin file ini menjadi .env lalu isi nilainya.
# Ambil dari Supabase Dashboard > Project Settings > API.
#
# Kunci publishable memang aman berada di browser: seluruh pembatasan akses
# ditegakkan oleh RLS di database, bukan oleh kerahasiaan kunci ini.
# Yang TIDAK BOLEH masuk ke sini adalah service_role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_REF=<project-ref>
